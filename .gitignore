# ---- 密钥与本地环境 ----
.env
.env.*
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# ---- 工具缓存 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
# 早前 Codex 会话用 --basetemp 写进仓库根的 pytest 临时目录（内容为测试 git 夹具，可弃）
.codex-pytest-tmp/
# 本机会话的 TMP 就落在仓库里，pytest 默认 basetemp 会写成 `pytest-of-<user>/`；
# 不挡住它的话 ruff 会去 lint 夹具副本。
pytest-of-*/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- CodePilot 运行产物（02「Artifact 目录」：运行产物不提交）----
artifacts/
!artifacts/.gitkeep
runs/
cache/

# ---- 数据库 ----
*.db
*.db-journal
*.sqlite
*.sqlite3

# ---- Docker / 沙箱 ----
sandbox/out/

# ---- Phase 13 Dashboard ----
web/node_modules/
web/dist/
web/.vite/
web/coverage/
*.tsbuildinfo

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---- 浏览器工具会话产物（可再生成，文件保留在磁盘，T13 决定）----
.playwright-mcp/
