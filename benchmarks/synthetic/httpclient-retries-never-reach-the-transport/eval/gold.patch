diff --git a/src/httpclient/transport.py b/src/httpclient/transport.py
index a25032c..fdf19d5 100644
--- a/src/httpclient/transport.py
+++ b/src/httpclient/transport.py
@@ -17,15 +17,15 @@ class Recorder:
 
     def __init__(self, responses: list[str]) -> None:
         self.responses = list(responses)
-        self.calls: list[tuple[str, float]] = []
+        self.calls: list[tuple[str, float, int]] = []
 
-    def __call__(self, url: str, timeout: float) -> str:
-        self.calls.append((url, timeout))
+    def __call__(self, url: str, timeout: float, retries: int) -> str:
+        self.calls.append((url, timeout, retries))
         if not self.responses:
             raise AssertionError("Recorder 的预设响应已用尽")
         return self.responses.pop(0)
 
 
-def build_sender(*, responses: list[str]) -> Callable[[str, float], str]:
