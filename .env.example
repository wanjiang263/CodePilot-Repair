# CodePilot-Repair 环境变量样例
# 只列出 key 名，不含任何真实值。复制为 .env 后自行填写；.env 永不提交。
# 配置项与 02「多 Provider 接入」/ 03 §24 一致。

# ---- LLM Provider 密钥（按 configs/llm.yaml 中 api_key_env 字段引用）----
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=
# AWS Bedrock uses the AWS SDK credential chain, not an API key.
# AWS_PROFILE=default
# AWS_REGION=us-east-1

# ---- 智谱 GLM ----
# 两家官方平台各自签发密钥，**互不通用**：
#   GLM_PLATFORM=zai        → https://api.z.ai/api/paas/v4      （国际站，USD 计价）
#   GLM_PLATFORM=bigmodel   → https://open.bigmodel.cn/api/paas/v4（中国站，CNY 计价）
# 标准 API 密钥与 Coding Plan 套餐密钥也互不通用；本工具只接标准 API 端点。
GLM_API_KEY=
# 旧变量名，仍作为 bigmodel provider 的备用读取名（新配置请直接用 GLM_API_KEY）
ZHIPU_API_KEY=
# 平台选择；不填按 zai。填了未知名字会直接报错，不会退回默认值。
GLM_PLATFORM=zai
# 以下四项都是可选覆盖；不设置时完全按 configs/llm.yaml 取值。
# GLM_BASE_URL=https://api.z.ai/api/paas/v4
# GLM_MODEL=glm-5
# GLM_TIMEOUT_SECONDS=60
# GLM_MAX_RETRIES=2

# 自建 / 其他 OpenAI 兼容服务的地址（可留空，默认走 configs/llm.yaml 中的 base_url）
OPENAI_BASE_URL=

# ---- 存储（02「存储」：SQLite 默认，PostgreSQL 可选）----
DATABASE_URL=sqlite:///./codepilot.db
# PostgreSQL 可选 profile 示例：
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/codepilot
REDIS_URL=

# ---- API（Phase 13）----
# 未配置时 api 服务拒绝启动（03 §29）
CODEPILOT_API_KEY=
CODEPILOT_API_HOST=127.0.0.1
CODEPILOT_API_PORT=8000
# Comma-separated HTTPS hosts accepted by POST /api/v1/tasks
CODEPILOT_API_ALLOWED_REPOSITORY_HOSTS=github.com
# Durable SQLite queue shared by `codepilot api` and `codepilot worker`
CODEPILOT_API_QUEUE_PATH=artifacts/api/api.sqlite3
CODEPILOT_API_EXECUTION_BACKEND=fake
# Live mode requires the docker backend. The explicit simulated-sandbox escape
# hatch exists only for tests and defaults to false.
CODEPILOT_API_ALLOW_LIVE_LLM=true
CODEPILOT_API_LIVE_ALLOW_SIMULATED_SANDBOX=false
CODEPILOT_API_MAX_LIVE_COST=1000
CODEPILOT_API_DEMO_ROOT=demo
# Optional Fernet key for the encrypted provider credential vault. When empty,
# a 0600 master key file is generated under artifacts/settings/.
CODEPILOT_SETTINGS_MASTER_KEY=
# Dashboard / docs locations (Compose overrides these to /app/...).
CODEPILOT_WEB_DIST_DIR=web/dist
CODEPILOT_DOCS_DIR=docs
CODEPILOT_README_PATH=README.md
CODEPILOT_WORKER_HEALTH_PATH=
# Read-only historical experiment catalog
CODEPILOT_API_HISTORY_CATALOG=configs/benchmarks.yaml
CODEPILOT_API_MAX_BODY_BYTES=262144
CODEPILOT_API_WORKER_LEASE_SECONDS=120

# ---- 运行配置路径 ----
CODEPILOT_CONFIG_DIR=configs
CODEPILOT_LLM_CONFIG=configs/llm.yaml
CODEPILOT_DEFAULT_CONFIG=configs/default.yaml
CODEPILOT_ARTIFACTS_DIR=artifacts
CODEPILOT_CACHE_DIR=cache

# ---- 运行模式 ----
# 记录每次 LLM 调用到 llm_calls.jsonl，可用于 ReplayLLM 回放
CODEPILOT_RECORD_LLM=true
# 用 ReplayLLM 替代真实 provider（离线确定性运行）；指向某个 run 的 llm_calls.jsonl
CODEPILOT_REPLAY_LLM_PATH=
CODEPILOT_LOG_LEVEL=INFO

# ---- Docker Compose only ----
# GID that owns /var/run/docker.sock on the host. On most Linux hosts:
#   DOCKER_GID=$(stat -c '%g' /var/run/docker.sock)
# Docker Desktop commonly works with 0. The socket is a privileged interface;
# see docs/06-security.md before exposing this stack beyond localhost.
DOCKER_GID=0
