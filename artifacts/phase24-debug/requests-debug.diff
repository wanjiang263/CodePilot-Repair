+    def _decode_chunks_with_detected_encoding(self, chunks):
+        """Detect encoding while retaining the bytes already read from the stream."""
+        from .packages.chardet.universaldetector import UniversalDetector
+
+        detector = UniversalDetector()
+        pending = []
+        for chunk in chunks:
+            pending.append(chunk)
+            detector.feed(chunk)
+            if detector.done:
+                break
+        detector.close()
+        encoding = detector.result['encoding'] or 'utf-8'
+        def buffered_chunks():
+            for chunk in pending:
+                yield chunk
+            for chunk in chunks:
+                yield chunk
+        for decoded in self._decode_chunks(buffered_chunks(), encoding):
+            yield decoded
+
+    def _decode_chunks(self, chunks, encoding):
+        """Incrementally decode chunks of the response body using the given
+        encoding, mirroring the behavior of :attr:`text` when the response
+        encoding falls back to :attr:`apparent_encoding`."""
+        decoder = codecs.getincrementaldecoder(encoding)(errors='replace')
+        for chunk in chunks:
+            rv = decoder.decode(chunk)
+            if rv:
+                yield rv
+        rv = decoder.decode(b'', final=True)
+        if rv:
+            yield rv
+
