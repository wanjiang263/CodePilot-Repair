+class ReadEvidenceInput(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+    reference: str = Field(pattern=r"^tool-results/[a-f0-9]{64}\.json$")
+    offset: int = Field(default=0, ge=0)
