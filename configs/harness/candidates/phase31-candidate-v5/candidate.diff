+def generate_receipt(
+    *,
+    repo: Path,
+    candidate: str,
+    archive_root: Path,
+    receipt: Path,
+    candidate_commit: str,
+    source_commit: str,
+    diff_base: str,
+    manifest_commit: str,
+    replace: bool = False,
+    reason: str = "",
