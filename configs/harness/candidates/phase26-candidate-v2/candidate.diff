+    return {
+        **fields,
+        "status": status,
+        "stop_reason": stop_reason,
+        "failure_reasons": [*state.failure_reasons, *reasons],
+        "events": _emit(state, deps, node, f"{status.value}:{stop_reason.value}"),
+    }
