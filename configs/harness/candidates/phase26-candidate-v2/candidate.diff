diff --git a/src/codepilot/graph/evidence.py b/src/codepilot/graph/evidence.py
new file mode 100644
index 0000000..cab4f38
--- /dev/null
+++ b/src/codepilot/graph/evidence.py
@@ -0,0 +1,218 @@
+"""Bounded evidence projections. These do not change acceptance or test accounting."""
+
+from __future__ import annotations
+
+from typing import Any
+
+from codepilot.graph.stop_rules import patch_hash
+from codepilot.sandbox.runners import requested_filter
+from codepilot.schemas.plan import RepairPlan
+from codepilot.schemas.state import RepairState
+
+
+def task_experience(state: RepairState) -> dict[str, Any]:
+    """L0 references the authoritative task state rather than copying a memory DB."""
+    return {
+        "id": f"L0:{state.run_id}",
+        "level": "L0",
+        "source_run": state.run_id,
+        "source": ["RepairState.plan", "RepairState.failure_summary", "RepairState.tool_calls"],
+        "applies_when": {"run_id": state.run_id, "candidate_hash": state.frozen_patch_hash},
+        "invalid_when": "task, candidate or public requirement changes; rederive from RepairState",
+        "version": state.policy_snapshot.get("version", "legacy"),
+        "status": "pending",
+        "action": "Use public contract and actual failure evidence; revise the hypothesis before repeating a failed patch.",
+        "evaluation_exposure": "public_only",
+    }
+
+
+def failure_summary(state: RepairState) -> dict[str, Any]:
+    attempt = state.current_attempt
+    if attempt is None or attempt.patch_hash != patch_hash(state.current_patch):
+        return {}
+    regression = attempt.regression
+    execution = attempt.execution
+    stage = "regression" if regression is not None else "target_tests"
+    if regression and regression.executions:
+        executions = list(regression.executions.values())
+        execution = next((e for e in executions if e.status.value != "PASS"), executions[-1])
+    if execution is None:
+        if attempt.validation.passed:
+            return {}
+        return {
+            "stage": "patch_validation",
+            "category": "product",
+            "expected": "A legal nonempty candidate satisfying patch rules",
+            "actual": attempt.validation.errors,
+            "candidate_hash": attempt.patch_hash,
+            "evidence_refs": [f"attempts/{attempt.iteration}/validation.json"],
+            "baseline_relation": "unknown",
+            "scope": {"observed": 0, "missing": None},
+            "new_since_last_attempt": {
+                "validation_changed": state.failure_summary.get("actual")
+                != attempt.validation.errors
+            },
+        }
+    executions = list(regression.executions.values()) if regression else [execution]
+    observed = sorted({t.node_id for e in executions for t in e.tests})
+    missing = (
+        list(regression.unexecuted_tests)
+        if regression
+        else list(
+            execution.diagnostics.get(
+                "requested_missing",
+                requested_filter(execution.tests, tuple(attempt.target_tests))[1],
+            )
+        )
+    )
+    requested = (
+        sorted(set(regression.executed_tests) | set(missing))
+        if regression
+        else list(attempt.target_tests)
+    )
+    failures = sorted({t.node_id for e in executions for t in e.failed_tests})
+    previous = state.failure_summary
+    baseline = state.baseline
+    new_failures = (
+        list(regression.new_failures)
+        if regression
+        else [
+            t
+            for t in failures
+            if baseline and str(baseline.outcomes.get(t)) == "passed" and t not in baseline.flaky
+        ]
+    )
+    categories = {"TIMEOUT": "timeout", "ENV_ERROR": "environment", "SANDBOX_ERROR": "tool"}
+    discriminator = state.plan.contract.discriminator if state.plan else None
+    return {
+        "stage": stage,
+        "category": categories.get(
+            execution.status.value, "product" if failures else "measurement"
+        ),
+        "expected": discriminator.text
+        if discriminator and discriminator.confidence != "unknown"
+        else "Public behavior expectation is unknown; selected validation scope must still complete.",
+        "actual": execution.error_reason or execution.status.value,
+        "candidate_hash": attempt.patch_hash if attempt else patch_hash(state.current_patch),
+        "evidence_refs": [e.artifact_dir for e in regression.executions.values()]
+        if regression
+        else [execution.artifact_dir],
+        "baseline_relation": "new_failures" if new_failures else "unchanged_or_unknown",
+        "scope": {
+            "requested": len(requested) if requested else None,
+            "observed": len(observed),
+            "missing": len(missing),
+            "missing_refs": missing[:20],
+            "selector_unit": "selectors; observed counts are test cases",
+        },
+        "failure_ids": failures[:20],
+        "failure_messages": [
+            {"node_id": t.node_id, "message": (t.message or "")[:1000]}
+            for e in executions
+            for t in e.failed_tests
+        ][:3],
+        "new_since_last_attempt": {
+            "new_missing_ids": sorted(
+                set(missing) - set(previous.get("scope", {}).get("missing_refs", []))
+            )[:20],
+            "new_failure_ids": sorted(set(failures) - set(previous.get("failure_ids", [])))[:20],
+            "category_changed": previous.get("actual")
+            != (execution.error_reason or execution.status.value),
+            "candidate_changed": previous.get("candidate_hash")
+            != (attempt.patch_hash if attempt else patch_hash(state.current_patch)),
+        },
+    }
+
+
+def verification_view(state: RepairState) -> dict[str, Any]:
+    """Keep execution, behavior, regression, review and coverage independent."""
+    attempt = state.current_attempt
+    candidate_bound = bool(attempt and attempt.patch_hash == patch_hash(state.current_patch))
+    regression = attempt.regression if attempt and candidate_bound else None
+    execution = attempt.execution if attempt and candidate_bound else None
+    review = state.review
+    bound = bool(review and review.reviewed_patch_hash == patch_hash(state.current_patch))
+    target_missing = (
+        requested_filter(execution.tests, tuple(attempt.target_tests))[1]
+        if execution and attempt
+        else []
+    )
+    layers = {
+        "requirement_behavior": {
+            "conclusion": "unknown",
+            "reason": "No independently bound public-behavior observation",
+            "sources": state.plan.contract.discriminator.source if state.plan else [],
+        },
+        "affected_regression": {
+            "candidate_bound": candidate_bound,
+            "requested": len(attempt.target_tests) if attempt else None,
+            "observed": len(execution.tests) if execution else 0,
+            "missing": target_missing if execution else None,
+        },
+        "expanded_validation": {
+            "mode": regression.mode.value if regression else None,
+            "complete": regression.complete if regression else None,
+            "missing": list(regression.unexecuted_tests) if regression else None,
+        },
+    }
+    return {
+        "layers": layers,
+        "execution": execution.status.value if execution else "NOT_EXECUTED",
+        "behavior": "unknown",  # Passing self-tests alone cannot prove the public contract.
+        "regression": "not_measured"
+        if regression is None
+        else (
+            "incomplete"
+            if not regression.complete
+            else "new_failures"
+            if regression.new_failures
+            else "clean"
+        ),
+        "review": "not_executed"
+        if review is None
+        else "stale"
+        if not bound
+        else "agree"
+        if review.approved
+        else "disagree",
+        "coverage": {
+            "observed": len(regression.executed_tests) if regression else 0,
+            "missing": len(regression.unexecuted_tests) if regression else None,
+            "mode": regression.mode.value if regression else None,
+        },
+        "official": "NOT_EVALUATED",  # Official verdicts remain external, bound records.
+    }
+
+
+def stage_handoff(state: RepairState, plan: RepairPlan) -> dict[str, Any]:
+    """Deterministic boundary summary, never an extra model call or mid-edit reset."""
+    failure = failure_summary(state)
+    return {
+        "kind": "deterministic_projection",
+        "model_summary": None,
+        "run_id": state.run_id,
+        "revision": state.runtime.get("revision", 0),
+        "policy_hash": state.policy_snapshot.get("sha256"),
+        "candidate_hash": patch_hash(state.current_patch) if state.current_patch else "",
+        "requirements": state.issue,
+        "contract": plan.contract.model_dump(mode="json"),
+        "plan": plan.model_dump(mode="json"),
+        "confirmed_facts": {"failure": failure, "sources": failure.get("evidence_refs", [])},
+        "excluded_hypotheses": [],
+        "excluded_hypotheses_note": "No explicit exclusion evidence; do not infer from repeated failure.",
+        "missing_facts": [
+            name
+            for name, item in plan.contract.model_dump().items()
+            if isinstance(item, dict) and item.get("confidence") == "unknown"
+        ],
+        "next_minimal_action": "Inspect the missing contract/source evidence, then modify the smallest supported production scope.",
+        "full_evidence_refs": [
+            "events.jsonl",
+            f"exploration/{state.iteration}.json",
+            *[
+                call.get("result_summary", {}).get("artifact_ref")
+                for call in state.tool_calls
+                if call.get("result_summary", {}).get("artifact_ref")
+            ],
+        ],
+    }
diff --git a/src/codepilot/graph/harness.py b/src/codepilot/graph/harness.py
new file mode 100644
index 0000000..40342cc
--- /dev/null
+++ b/src/codepilot/graph/harness.py
@@ -0,0 +1,282 @@
+"""Small lifecycle integration for the existing graph and checkpoint state."""
+
+from __future__ import annotations
+
+import json
+from typing import Any
+
+from codepilot.graph.deps import Deps
+from codepilot.graph.evidence import failure_summary, verification_view
+from codepilot.observability.lifecycle import snapshot_hash
+from codepilot.rsi import archive_root, load_selection, read_json, retrieve, snapshot_sources
+from codepilot.schemas.state import RepairState
+
+
+class SnapshotIdentityError(ValueError):
+    """A resumed task must never silently switch its fixed policy."""
+
+
+def begin(state: RepairState, deps: Deps, stage: str) -> RepairState:
+    try:
+        return _begin(state, deps, stage)
+    except SnapshotIdentityError as exc:
+        deps.lifecycle.emit("initialization_failed", category="identity", error=str(exc))
+        if stage != "finalize":
+            raise
+        # Finalize must still preserve the original failure, patch and usage.
+        return state
+    except Exception as exc:
+        deps.lifecycle.emit(
+            "initialization_failed", category="optional", error=str(exc), fallback="existing_node"
+        )
+        return state
+
+
+def _begin(state: RepairState, deps: Deps, stage: str) -> RepairState:
+    policy = state.policy_snapshot
+    if not deps.harness_started:
+        if policy:
+            try:
+                snapshot = read_json(deps.artifacts.run_dir / "harness/snapshot.json")
+            except (OSError, ValueError) as exc:
+                raise SnapshotIdentityError(
+                    "fixed snapshot unavailable; preserve recovery scene"
+                ) from exc
+            if snapshot.get("state_schema_version", 1) != 1:
+                raise SnapshotIdentityError("snapshot state schema is incompatible")
+            if snapshot_hash(snapshot) != policy.get("sha256"):
+                raise SnapshotIdentityError(
+                    "fixed policy snapshot identity mismatch; refusing in-flight switch"
+                )
+        else:
+            try:
+                selection = load_selection()
+            except (OSError, ValueError, KeyError) as exc:
+                deps.lifecycle.emit("policy_load_failed", error=str(exc), fallback="builtin")
+                selection = {
+                    "schema_version": 1,
+                    "version": "builtin-phase26-v1",
+                    "status": "pending",
+                    "instruction": "",
+                    "experiences": [],
+                }
+            try:
+                sources = snapshot_sources()
+            except OSError as exc:
+                deps.lifecycle.emit("source_snapshot_unavailable", error=str(exc))
+                sources = {}
+            snapshot = {
+                "selection": selection,
+                "selection_source": str(archive_root()),
+                "sources": sources,
+                "plugins": deps.lifecycle.versions(),
+                "configuration": {
+                    "environment": deps.env_spec.model_dump(mode="json"),
+                    "budget": state.budget.model_dump(mode="json"),
+                    "repository": deps.repository,
+                    "base_commit": state.base_commit,
+                },
+                "state_schema_version": 1,
+                "prompts": {
+                    "coder": selection.get("prompts", {}).get(
+                        "coder", getattr(deps.coder, "system_prompt", "")
+                    ),
+                    "planner": selection.get("prompts", {}).get(
+                        "planner", getattr(deps.planner, "system_prompt", "")
+                    ),
+                    "reviewer": selection.get("prompts", {}).get(
+                        "reviewer", getattr(deps.reviewer, "system_prompt", "")
+                    ),
+                },
+            }
+            deps.artifacts.write_json("harness/snapshot.json", snapshot)
+            policy = {
+                "version": selection["version"],
+                "sha256": snapshot_hash(snapshot),
+                "artifact": "harness/snapshot.json",
+                "status": selection.get("status", "pending"),
+            }
+        selection = snapshot["selection"]
+        deps.experience_snapshot = []
+        cache = getattr(deps.tools, "query_cache", None)
+        if cache is not None:
+            counters = state.runtime.get("cache", {})
+            cache.hits = int(counters.get("hits", 0))
+            cache.misses = int(counters.get("misses", 0))
+            if state.events:
+                cache.last_invalidation = "worker_restart_no_memory_cache"
+        for name, prompt in snapshot.get("prompts", {}).items():
+            agent = getattr(deps, name, None)
+            if agent is not None and hasattr(agent, "system_prompt"):
+                agent.system_prompt = prompt
+        deps.coder.experience_feedback = json.dumps(
+            {"instruction": selection.get("instruction", ""), "entries": deps.experience_snapshot},
+            ensure_ascii=False,
+        )
+        deps.fixed_selection = selection
+        deps.harness_started = True
+        deps.lifecycle.bind(
+            {"task_id": state.task_id, "stage": stage, "iteration": state.iteration},
+            str(policy.get("sha256", "")),
+        )
+        deps.lifecycle.emit(
+            "resume" if state.events else "task_start",
+            snapshot=policy,
+            reuse="checkpoint-completed nodes, settled responses and identity-valid evidence"
+            if state.events
+            else "none",
+            redo="pending or invalidated stages; no exactly-once guarantee across crash windows"
+            if state.events
+            else "none",
+        )
+    if deps.harness_started:
+        try:
+            audit: list[dict[str, Any]] = []
+            deps.experience_snapshot = retrieve(
+                deps.fixed_selection,
+                deps.repository,
+                stage=stage,
+                failure_category=state.failure_summary.get("category"),
+                environment={
+                    "runner": deps.env_spec.test_command,
+                    "environment": snapshot_hash(deps.env_spec.model_dump(mode="json")),
+                    "version": deps.env_spec.python_version,
+                },
+                tags=tuple(state.issue_analysis.keywords) if state.issue_analysis else (),
+                audit=audit,
+            )
+            deps.coder.experience_feedback = json.dumps(
+                {
+                    "instruction": deps.fixed_selection.get("instruction", "")[:1000],
+                    "entries": deps.experience_snapshot,
+                    "advisory": True,
+                },
+                ensure_ascii=False,
+            )
+            deps.lifecycle.emit("experience_selection", decisions=audit)
+        except Exception as exc:
+            deps.experience_snapshot = []
+            deps.coder.experience_feedback = ""
+            deps.lifecycle.emit("experience_unavailable", error=str(exc), fallback="no_experience")
+    now = deps.clock().isoformat()
+    deps.lifecycle.external_wait_seconds = 0.0
+    deps.lifecycle.queued_seconds = 0.0
+    runtime = {
+        **state.runtime,
+        "stage": stage,
+        "stage_started_at": now,
+        "stage_elapsed_seconds": 0.0,
+        "activity": "executing",
+        "revision": int(state.runtime.get("revision", 0)) + 1,
+    }
+    deps.lifecycle.bind(
+        {
+            "task_id": state.task_id,
+            "stage": stage,
+            "iteration": state.iteration,
+            "revision": runtime["revision"],
+            "candidate_hash": state.frozen_patch_hash,
+        },
+        str(policy.get("sha256", "")),
+    )
+    deps.lifecycle.emit("stage_start", started_at=now, runtime=runtime)
+    return state.model_copy(
+        update={
+            "runtime": runtime,
+            "policy_snapshot": policy,
+            "experience_refs": [f"{e['id']}@{e['version']}" for e in deps.experience_snapshot],
+        }
+    )
+
+
+def complete(
+    state: RepairState, update: dict[str, Any], deps: Deps, elapsed: float
+) -> dict[str, Any]:
+    merged = state.model_copy(update=update)
+    runtime = {
+        **state.runtime,
+        "stage_elapsed_seconds": round(elapsed, 3),
+        "activity": "idle",
+        "last_completed_at": deps.clock().isoformat(),
+    }
+    durations = dict(runtime.get("stage_seconds", {}))
+    stage = str(runtime.get("stage", "unknown"))
+    durations[stage] = round(durations.get(stage, 0) + elapsed, 3)
+    runtime["stage_seconds"] = durations
+    runtime["external_wait_seconds"] = round(
+        float(state.runtime.get("external_wait_seconds", 0)) + deps.lifecycle.external_wait_seconds,
+        3,
+    )
+    runtime["resource_queued_seconds"] = (
+        float(state.runtime.get("resource_queued_seconds", 0)) + deps.lifecycle.queued_seconds
+    )
+    runtime["executing_seconds"] = round(
+        float(state.runtime.get("executing_seconds", 0))
+        + max(0, elapsed - deps.lifecycle.external_wait_seconds - deps.lifecycle.queued_seconds),
+        3,
+    )
+    cache = getattr(deps.tools, "query_cache", None)
+    runtime["has_modification"] = bool(merged.current_patch)
+    runtime["event_seq"] = deps.events.last_seq
+    runtime["run_id"] = merged.run_id
+    runtime["cache"] = {"hits": cache.hits, "misses": cache.misses} if cache else {}
+    if merged.current_patch != state.current_patch:
+        deps.lifecycle.emit(
+            "candidate_changed",
+            old=state.frozen_patch_hash,
+            new=merged.frozen_patch_hash,
+            has_modification=bool(merged.current_patch),
+        )
+        runtime["last_effective_progress"] = deps.clock().isoformat()
+    if stage in {"validate_patch", "run_target_tests", "run_regression"}:
+        summary = failure_summary(merged)
+        write_projection(deps, f"failures/{stage}-{state.iteration}.json", summary)
+        update["failure_summary"] = summary
+        deps.lifecycle.emit(
+            "after_validation", view=verification_view(merged), failure_summary=summary
+        )
+        old_evidence = {
+            k: v
+            for k, v in state.failure_summary.items()
+            if k not in {"new_since_last_attempt", "evidence_refs"}
+        }
+        new_evidence = {
+            k: v for k, v in summary.items() if k not in {"new_since_last_attempt", "evidence_refs"}
+        }
+        if summary and new_evidence != old_evidence:
+            runtime["last_effective_progress"] = deps.clock().isoformat()
+    if stage == "plan" and merged.plan:
+        contract = merged.plan.contract.model_dump(mode="json")
+        write_projection(deps, "harness/contract.json", contract)
+        deps.lifecycle.emit("contract_ready", contract=contract)
+        if state.plan is None or (
+            merged.plan.root_cause_hypothesis != state.plan.root_cause_hypothesis
+            or merged.plan.evidence != state.plan.evidence
+        ):
+            runtime["last_effective_progress"] = deps.clock().isoformat()
+    for call in update.get("tool_calls", []):
+        progress = call.get("result_summary", {}).get("exploration", {})
+        if (
+            progress.get("new_relevant_evidence")
+            or progress.get("hypothesis_changed")
+            or progress.get("candidate_changed")
+        ):
+            runtime["last_effective_progress"] = deps.clock().isoformat()
+            runtime["progress_basis"] = "planned_file_overlap_or_stated_hypothesis; heuristic"
+    runtime["event_seq"] = deps.events.last_seq + 1
+    deps.lifecycle.emit("stage_end", duration_seconds=elapsed, runtime=runtime)
+    return {
+        **update,
+        "runtime": runtime,
+        "policy_snapshot": state.policy_snapshot,
+        "experience_refs": state.experience_refs,
+    }
+
+
+def write_projection(deps: Deps, path: str, payload: Any) -> bool:
+    try:
+        deps.artifacts.write_json(path, payload)
+        return True
+    except Exception as exc:
+        deps.lifecycle.emit("projection_error", artifact=path, error=str(exc))
+        return False
