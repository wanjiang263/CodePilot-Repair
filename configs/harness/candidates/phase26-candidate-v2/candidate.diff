-                    workspace=workspace,
-                    artifacts=artifacts,
-                    policy=policy,
-                    reproducer_policy=reproducer_policy,
-                    index=index,
-                    env_spec=env_spec,
-                    checkpoint_path=checkpoint_path if self._checkpoint else None,
-                    resuming=resuming,
-                )
-        finally:
-            engine.dispose()
-        return self._outcome(
-            run_id=run_id,
-            seed=seed,
-            state=state,
-            artifacts=artifacts,
-            runtime=time.time() - started,
-        )
