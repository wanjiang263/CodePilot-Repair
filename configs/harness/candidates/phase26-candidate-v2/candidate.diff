+
+
+def _emit(
+    state: RepairState,
+    deps: Deps,
+    node: str,
+    status: str,
+    *,
+    type: EventType = EventType.NODE_END,
+    error: str | None = None,
+    **extra: Any,
+) -> list[dict[str, Any]]:
+    """写事件：JSONL/DB 走 EventSink，State 里留一条精简轨迹。
+
+    两边都写是有意的：State 里的事件让报告与 checkpoint 自解释，而 EventSink
+    带 seq / 时间戳 / 用量，是恢复和 API SSE 的数据源。只留一边要么让报告失真，
+    要么让运行期观测不到。
