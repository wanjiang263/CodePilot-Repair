diff --git a/tests/unit/test_phase33_runtime_results.py b/tests/unit/test_phase33_runtime_results.py
new file mode 100644
index 0000000..069cff9
--- /dev/null
+++ b/tests/unit/test_phase33_runtime_results.py
@@ -0,0 +1,178 @@
+"""Phase34 T01: the runtime JSON records evidence through a commit, not HEAD.
+
+The Phase33 defect: the JSON was written at C3, but --check recomputed
+``base..HEAD`` and compared against it, so the docs/receipt commit C4 became an
+extra ``code_commits`` entry and the check could never pass at the final HEAD.
+These tests pin the corrected lifecycle on throwaway repositories:
+
+- ``recorded_through``/``head_commit`` come from the written file;
+- ``phase_commits`` = ``base..recorded_through``;
+- ``code_commits`` is path-filtered (docs/archive commits never count);
+- docs-only commits after the evidence keep --check green;
+- code commits after the evidence fail with ``code_changed_after_evidence``;
+- tampering a recorded commit or hash fails;
+- two --write runs are byte-identical and --check never writes.
+"""
+
+from __future__ import annotations
+
+import json
+import subprocess
+from pathlib import Path
+from typing import Any
+
+import pytest
+from scripts import phase33_runtime_results as runtime
+
+
+def git(repo: Path, *args: str) -> str:
+    done = subprocess.run(
+        ["git", "-C", str(repo), *args],
+        capture_output=True,
+        text=True,
+        encoding="utf-8",
+        check=False,
+    )
+    assert done.returncode == 0, done.stderr
+    return done.stdout.strip()
+
+
+def commit(repo: Path, message: str) -> str:
+    git(repo, "add", "-A")
+    git(repo, "commit", "-qm", message)
+    return git(repo, "rev-parse", "HEAD")
+
+
+def write(path: Path, text: str) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(text, encoding="utf-8", newline="\n")
+
+
+@pytest.fixture
+def env(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> dict[str, Any]:
+    repo = tmp_path / "repo"
+    repo.mkdir()
+    git(repo, "init", "-q")
+    git(repo, "config", "user.name", "Phase34 fixture")
+    git(repo, "config", "user.email", "fixture@example.invalid")
+    git(repo, "config", "core.autocrlf", "false")
+    write(repo / "src/app.py", "value = 1\n")
+    base = commit(repo, "base")
+    write(repo / "src/app.py", "value = 2\n")
+    code = commit(repo, "code change")
+    write(repo / "docs/notes/phase.md", "evidence\n")
+    tip = commit(repo, "docs change")
+    monkeypatch.setattr(runtime, "ROOT", repo)
+    return {
+        "repo": repo,
+        "base": base,
+        "code": code,
+        "tip": tip,
+        "scratch": tmp_path / "scratch",
+        "out": tmp_path / "runtime.json",
+    }
+
+
+def run(env: dict[str, Any], mode: str, *extra: str) -> int:
+    return runtime.main([mode, "--scratch", str(env["scratch"]), "--out", str(env["out"]), *extra])
+
+
+def written(env: dict[str, Any]) -> dict[str, Any]:
+    return json.loads(env["out"].read_text(encoding="utf-8"))
+
+
+def store(env: dict[str, Any], payload: dict[str, Any]) -> None:
+    env["out"].write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
+
+
+def test_write_records_lifecycle_and_filters_code_commits(env: dict[str, Any]) -> None:
+    assert run(env, "--write", "--base", env["base"]) == 0
+    payload = written(env)
+    assert payload["recorded_through"] == env["tip"]
+    assert payload["head_commit"] == env["tip"]
+    assert {item["hash"] for item in payload["phase_commits"]} == {env["code"], env["tip"]}
+    # the docs commit is inside the phase window but must not be a code commit
+    assert [item["hash"] for item in payload["code_commits"]] == [env["code"]]
+
+
+def test_check_passes_at_recorded_through(env: dict[str, Any]) -> None:
+    assert run(env, "--write", "--base", env["base"]) == 0
+    assert run(env, "--check") == 0
+
+
+def test_docs_only_commit_after_evidence_keeps_check_green(env: dict[str, Any]) -> None:
+    assert run(env, "--write", "--base", env["base"]) == 0
+    write(env["repo"] / "docs/notes/after.md", "later docs\n")
+    commit(env["repo"], "docs after evidence")
+    assert run(env, "--check") == 0
+
+
+def test_code_commit_after_evidence_fails(
+    env: dict[str, Any], capsys: pytest.CaptureFixture[str]
+) -> None:
+    assert run(env, "--write", "--base", env["base"]) == 0
+    write(env["repo"] / "src/app.py", "value = 3\n")
+    commit(env["repo"], "code after evidence")
+    assert run(env, "--check") == 1
+    assert "code_changed_after_evidence" in capsys.readouterr().out
+
+
+def test_missing_recorded_through_fails(
+    env: dict[str, Any], capsys: pytest.CaptureFixture[str]
+) -> None:
+    assert run(env, "--write", "--base", env["base"]) == 0
+    payload = written(env)
+    payload.pop("recorded_through")
+    store(env, payload)
+    assert run(env, "--check") == 1
+    assert "recorded_through_missing" in capsys.readouterr().out
+
+
+def test_unknown_recorded_through_fails(
+    env: dict[str, Any], capsys: pytest.CaptureFixture[str]
+) -> None:
+    assert run(env, "--write", "--base", env["base"]) == 0
+    payload = written(env)
+    payload["recorded_through"] = "0" * 40
+    store(env, payload)
+    assert run(env, "--check") == 1
+    assert "recorded_through_unknown" in capsys.readouterr().out
+
+
+def test_tampered_code_commit_hash_fails(
+    env: dict[str, Any], capsys: pytest.CaptureFixture[str]
+) -> None:
+    assert run(env, "--write", "--base", env["base"]) == 0
+    payload = written(env)
+    payload["code_commits"][0]["hash"] = env["tip"]
+    payload["code_commits"][0]["short"] = env["tip"][:7]
+    store(env, payload)
+    assert run(env, "--check") == 1
+    output = capsys.readouterr().out
+    assert "payload_mismatch" in output
+    assert "code_commits" in output
+
+
+def test_tampered_head_commit_fails(
+    env: dict[str, Any], capsys: pytest.CaptureFixture[str]
+) -> None:
+    assert run(env, "--write", "--base", env["base"]) == 0
+    payload = written(env)
+    payload["head_commit"] = env["base"]
+    store(env, payload)
+    assert run(env, "--check") == 1
+    assert "head_recorded_mismatch" in capsys.readouterr().out
+
+
+def test_double_write_is_byte_identical(env: dict[str, Any]) -> None:
+    assert run(env, "--write", "--base", env["base"]) == 0
+    first = env["out"].read_bytes()
+    assert run(env, "--write") == 0  # base is read back from the written file
+    assert env["out"].read_bytes() == first
+
+
+def test_check_does_not_modify_json(env: dict[str, Any]) -> None:
+    assert run(env, "--write", "--base", env["base"]) == 0
+    before = env["out"].read_bytes()
+    assert run(env, "--check") == 0
+    assert env["out"].read_bytes() == before
diff --git a/tests/unit/test_phase34_archive_normalization.py b/tests/unit/test_phase34_archive_normalization.py
new file mode 100644
index 0000000..57cd977
--- /dev/null
+++ b/tests/unit/test_phase34_archive_normalization.py
@@ -0,0 +1,138 @@
+"""Phase34 T02: normalization policy must match what the archive actually stores.
+
+History: git_commit candidates only ever stored LF-normalized source_hashes, yet
+their note claimed raw worktree hashes were recorded separately. New candidates
+now carry a structured ``normalization_policy`` and a mode-specific note; the
+verifier rejects a claim without structure and annotates legacy v5/v6 candidates
+(``normalization_note_stale``) without failing them.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+from typing import Any
+
+from scripts.phase28_archive_verify import (
+    LEGACY_NORMALIZATION_NOTE,
+    verify_new_archive,
+)
+from test_phase28_archive import FEATURE_V2, build_repo
+from test_phase28_archive import generate as generate_schema3
+from test_phase31_archive_manifest import CHILD, commit, generate, read, write
+from test_phase31_archive_manifest import env as env
+from test_phase31_archive_manifest import git as git_cmd
+
+from codepilot.archive import (
+    GIT_NORMALIZATION_POLICY,
+    NORMALIZATION_NOTE,
+    NORMALIZATION_NOTE_WORKTREE,
+    canonical_sha256,
+    create_candidate,
+)
+
+
+def reseal(record: dict[str, Any]) -> None:
+    record.pop("candidate_payload_sha256", None)
+    record["candidate_payload_sha256"] = canonical_sha256(record)
+
+
+def verify(env: dict) -> dict:
+    folder = env["root"] / "candidates" / CHILD
+    return verify_new_archive(
+        folder,
+        read(folder / "candidate.json"),
+        archive_root=env["root"],
+        repo=env["repo"],
+        ignore_raw_drift=True,
+    )
+
+
+def test_new_candidate_records_policy_and_matching_note(env: dict) -> None:
+    generate(env)
+    record = read(env["root"] / "candidates" / CHILD / "candidate.json")
+    assert record["normalization"] == NORMALIZATION_NOTE
+    assert record["normalization_policy"] == GIT_NORMALIZATION_POLICY
+    result = verify(env)
+    assert result["ok"], result["failures"]
+    assert result["normalization_note_stale"] is False
+
+
+def test_legacy_note_without_policy_is_annotated_not_failed(env: dict) -> None:
+    generate(env)
+    path = env["root"] / "candidates" / CHILD / "candidate.json"
+    record = read(path)
+    record["normalization"] = LEGACY_NORMALIZATION_NOTE
+    record.pop("normalization_policy")
+    reseal(record)
+    write(path, json.dumps(record))
+    result = verify(env)
+    assert result["ok"], result["failures"]
+    assert result["normalization_note_stale"] is True
+    check = next(c for c in result["checks"] if c["check"] == "normalization_policy")
+    assert check["ok"] and "normalization_note_stale" in check["detail"]
+
+
+def test_policy_claiming_raw_hashes_are_stored_fails(env: dict) -> None:
+    generate(env)
+    path = env["root"] / "candidates" / CHILD / "candidate.json"
+    record = read(path)
+    record["normalization_policy"]["raw_hashes_stored"] = True
+    reseal(record)
+    write(path, json.dumps(record))
+    result = verify(env)
+    assert not result["ok"]
+    assert "normalization_policy" in {failure["check"] for failure in result["failures"]}
+
+
+def test_new_note_without_policy_fails(env: dict) -> None:
+    generate(env)
+    path = env["root"] / "candidates" / CHILD / "candidate.json"
+    record = read(path)
+    record.pop("normalization_policy")
+    reseal(record)
+    write(path, json.dumps(record))
+    result = verify(env)
+    assert not result["ok"]
+    check = next(c for c in result["checks"] if c["check"] == "normalization_policy")
+    assert not check["ok"]
+    assert result["normalization_note_stale"] is False
+
+
+def test_worktree_candidate_keeps_raw_hashes_without_policy(tmp_path: Path) -> None:
+    repo = tmp_path / "repo"
+    repo.mkdir()
+    git_cmd(repo, "init", "-q")
+    git_cmd(repo, "config", "user.name", "Phase34 fixture")
+    git_cmd(repo, "config", "user.email", "fixture@example.invalid")
+    git_cmd(repo, "config", "core.autocrlf", "false")
+    (repo / "src").mkdir()
+    (repo / "src/app.py").write_text("value = 1\n", encoding="utf-8", newline="\n")
+    base = commit(repo, "base")
+    root = repo / "configs/harness"
+    create_candidate(
+        root,
+        repo,
+        version="phase34-worktree",
+        diff_base_commit=base,
+        source_origin="worktree",
+        source_files=["src/app.py"],
+    )
+    record = read(root / "candidates" / "phase34-worktree" / "candidate.json")
+    assert record["normalization"] == NORMALIZATION_NOTE_WORKTREE
+    assert "normalization_policy" not in record
+    assert set(record["raw_worktree_hashes"]) == {"src/app.py"}
+
+
+def test_crlf_source_hashes_only_lf_bytes(tmp_path: Path) -> None:
+    repo, base, head = build_repo(tmp_path)
+    root = tmp_path / "archive"
+    generate_schema3(root, repo, "phase34-crlf", base, head)
+    record = read(root / "candidates" / "phase34-crlf" / "candidate.json")
+    lf_hash = hashlib.sha256(FEATURE_V2.encode("utf-8")).hexdigest()
+    raw_hash = hashlib.sha256((repo / "src/feature.py").read_bytes()).hexdigest()
+    assert record["source_hashes"]["src/feature.py"] == lf_hash
+    assert lf_hash != raw_hash
+    assert record["normalization"] == NORMALIZATION_NOTE
+    assert record["normalization_policy"] == GIT_NORMALIZATION_POLICY
