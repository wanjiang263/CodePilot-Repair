index 0000000..3f0459a
--- /dev/null
+++ b/src/codepilot/observability/resources.py
@@ -0,0 +1,204 @@
+"""Local-machine execution gates, reusing worker execution paths.
+
+OS locks also coordinate worker processes. Lock files are retained, never used as
+ownership/PID claims; the kernel releases ownership on process exit. No service,
+model retry, download cancellation or budget change is introduced.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import errno
+import hashlib
+import os
+import sys
+import tempfile
+import threading
+import time
+from collections.abc import Callable, Iterator
+from contextlib import contextmanager
+from contextvars import ContextVar
+from pathlib import Path
+from typing import Any, BinaryIO
+
+_guard = threading.Lock()
+_locks: dict[str, tuple[Any, int]] = {}
+_held: ContextVar[frozenset[tuple[int, int, str]]] = ContextVar(
+    "resource_ownership", default=frozenset()
+)
+
+
+class ResourceCancelledError(RuntimeError):
+    """Cancellation before dispatch; no external request or uncertain usage."""
+
+
+@contextmanager
+def resource_slot(
+    resource: str,
+    *,
+    workspace: Path | None = None,
+    cancel: Callable[[], bool] | None = None,
+    observe: Callable[..., Any] | None = None,
+) -> Iterator[None]:
+    # Production graph I/O runs in a dedicated worker. A direct synchronous
+    # caller on an event-loop thread may take an immediately free slot only;
+    # it must offload rather than blocking that loop on contention.
+    can_wait = True
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        pass
+    else:
+        from codepilot.observability.dispatch import _current
+
+        scope = _current.get()
+        can_wait = bool(
+            scope
+            and scope.synchronous_worker
+            and scope.worker_task_id == id(asyncio.current_task())
+        )
+    from codepilot.observability.dispatch import check_dispatch
+
+    check_dispatch(resource)
+    key = "pressure" if resource in {"test", "heavy"} else resource
+    if workspace is not None:
+        key = "workspace:" + os.path.normcase(str(workspace.resolve()))
+    try:
+        task = asyncio.current_task()
+    except RuntimeError:
+        task = None
+    owner = (threading.get_ident(), id(task))
+    held = _held.get()
+    claim = (*owner, key)
+    owned = {k for thread, task_id, k in held if (thread, task_id) == owner}
+    if claim in held:
+        yield
+        return
+    if (key == "pressure" and any(k.startswith("workspace:") for k in owned)) or (
+        key.startswith("workspace:") and any(k.startswith("workspace:") and k > key for k in owned)
+    ):
+        raise RuntimeError("resource lock order: pressure before sorted workspace paths")
+    with _guard:
+        lock, users = _locks.get(key, (threading.Lock(), 0))
+        _locks[key] = (lock, users + 1)
+    started = time.monotonic()
+    acquired = False
+    execution_started = started
+    handle: BinaryIO | None = None
+    os_acquired = False
+    dispatched = False
+    try:
+        if observe:
+            observe("resource_wait", resource=resource)
+        while not acquired:
+            check_dispatch(resource)
+            if cancel and cancel():
+                raise ResourceCancelledError(f"cancelled waiting for {resource}; not dispatched")
+            acquired = lock.acquire(timeout=0.1 if can_wait else 0)
+            if not acquired and not can_wait:
+                raise RuntimeError(
+                    "contended synchronous resource gate must run in a worker thread"
+                )
+        if cancel and cancel():
+            raise ResourceCancelledError(f"cancelled before {resource} dispatch")
+        folder = Path(tempfile.gettempdir()) / "codepilot-resource-locks"
+        folder.mkdir(parents=True, exist_ok=True)
+        handle = (folder / (hashlib.sha256(key.encode()).hexdigest() + ".lock")).open("a+b")
+        if handle.seek(0, 2) == 0:
+            handle.write(b"0")
+            handle.flush()
+        while not os_acquired:
+            check_dispatch(resource)
+            if cancel and cancel():
+                raise ResourceCancelledError(f"cancelled waiting for {resource}; not dispatched")
+            os_acquired = _os_lock(handle, acquire=True)
+            if not os_acquired:
+                if not can_wait:
+                    raise RuntimeError("contended OS resource gate must run in a worker thread")
+                time.sleep(0.1)
+        check_dispatch(resource)
+        if cancel and cancel():
+            raise ResourceCancelledError(f"cancelled before {resource} dispatch")
+        execution_started = time.monotonic()
+        dispatched = True
+        _held.set(held | {claim})
+        if observe:
+            observe(
+                "resource_acquired", resource=resource, queued_seconds=execution_started - started
+            )
+        yield
+    finally:
+        try:
+            if handle is not None:
+                handle.close()  # OS ownership is released even after a process exits.
+        finally:
+            if acquired:
+                _held.set(held)
+                lock.release()
+            with _guard:
+                _, users = _locks[key]
+                if users == 1:
+                    del _locks[key]
+                else:
+                    _locks[key] = (lock, users - 1)
+            if observe and dispatched:
+                observe(
+                    "resource_released",
+                    resource=resource,
+                    execution_seconds=time.monotonic() - execution_started,
+                )
+
+
+def _os_lock(handle: BinaryIO, *, acquire: bool) -> bool:
+    try:
+        handle.seek(0)
+        if sys.platform == "win32":
+            import msvcrt
+
+            msvcrt.locking(handle.fileno(), msvcrt.LK_NBLCK if acquire else msvcrt.LK_UNLCK, 1)
+        else:
+            import fcntl
+
+            fcntl.flock(
+                handle.fileno(), (fcntl.LOCK_EX | fcntl.LOCK_NB) if acquire else fcntl.LOCK_UN
+            )
+    except OSError as exc:
+        if acquire and exc.errno in {errno.EACCES, errno.EAGAIN, errno.EDEADLK}:
+            return False
+        raise
+    return True
+
+
+@contextmanager
+def preparation_stage(
+    stage: str, lifecycle: Any, cancel: Callable[[], bool] | None, *, gate: bool = True
+) -> Iterator[None]:
+    from datetime import UTC, datetime
+
+    started = time.monotonic()
+    runtime = {
+        "stage": stage,
+        "stage_started_at": datetime.now(UTC).isoformat(),
+        "stage_elapsed_seconds": 0.0,
+        "activity": "executing",
+        "revision": 0,
+    }
+    lifecycle.emit("stage_start", runtime=runtime)
+    try:
+        if gate:
+            with resource_slot("heavy", cancel=cancel, observe=lifecycle.emit):
+                yield
+        else:
+            yield
+    except Exception as exc:
+        lifecycle.emit("preparation_error", stage=stage, error=str(exc))
+        raise
+    finally:
+        lifecycle.emit(
+            "stage_end",
+            runtime={
+                **runtime,
+                "activity": "idle",
+                "stage_elapsed_seconds": time.monotonic() - started,
+            },
+        )
diff --git a/src/codepilot/observability/runtime.py b/src/codepilot/observability/runtime.py
new file mode 100644
index 0000000..f414390
--- /dev/null
+++ b/src/codepilot/observability/runtime.py
@@ -0,0 +1,95 @@
+"""Canonical deterministic projection shared by event publication and API reads."""
+
+from __future__ import annotations
+
+from datetime import datetime
+from typing import Any
+
+
+def project_event(previous: dict[str, Any], event: dict[str, Any]) -> dict[str, Any]:
+    runtime = dict(previous)
+    seq = int(event.get("seq", 0))
+    runtime["run_id"] = event.get("run_id")
+    extra = event.get("extra") or {}
+    facts = extra.get("facts") or {}
+    hook = extra.get("hook")
+    for suggestion in extra.get("suggestions", []):
+        if suggestion.get("resource"):
+            runtime["resource"] = suggestion["resource"]
+    if hook in {"stage_start", "stage_end"}:
+        incoming = facts.get("runtime") or {}
+        if int(incoming.get("revision", 0)) < int(runtime.get("revision", 0)):
+            return runtime
+        runtime.update(incoming)
+    if hook == "before_model":
+        runtime["activity"] = "external_wait"
+    if event.get("type") == "llm_call" or hook in {
+        "after_model",
+        "before_tool",
+        "after_tool",
+        "exploration",
+    }:
+        runtime["activity"] = "executing"
+    if hook == "exploration" and (
+        facts.get("new_relevant_evidence")
+        or facts.get("hypothesis_changed")
+        or facts.get("candidate_changed")
+    ):
+        runtime["last_effective_progress"] = event.get("timestamp")
+    if hook in {"exploration", "candidate_changed"} and "has_modification" in facts:
+        runtime["has_modification"] = facts["has_modification"]
+    if hook == "candidate_changed":
+        runtime["last_effective_progress"] = event.get("timestamp")
+    if hook == "resource_wait":
+        runtime["activity"] = "queued"
+    if hook == "resource_acquired":
+        runtime["activity"] = "executing"
+        runtime["resource_queued_seconds"] = float(
+            runtime.get("resource_queued_seconds", 0)
+        ) + facts.get("queued_seconds", 0)
+    if hook in {"task_start", "resume"}:
+        runtime["policy_snapshot"] = facts.get("snapshot", {})
+    if hook == "preparation_progress":
+        runtime["preparation_progress"] = {
+            "phase": facts.get("phase"),
+            "counts": facts.get("counts"),
+            "source": facts.get("source"),
+        }
+    if hook == "resume":
+        runtime["recovery"] = {"reuse": facts.get("reuse"), "redo": facts.get("redo")}
+    if hook == "contract_ready":
+        runtime["contract"] = facts.get("contract")
+    if hook == "after_validation":
+        runtime["verification"] = facts.get("view")
+        runtime["failure_summary"] = facts.get("failure_summary")
+    if hook == "after_tool" and facts.get("cache"):
+        runtime["last_cache"] = facts["cache"]
+    if hook == "stage_end":
+        runtime["activity"] = "idle"
+    runtime["event_seq"] = max(seq, int(runtime.get("event_seq", 0)))
+    return runtime
+
+
+def activity_view(events: list[dict[str, Any]], *, now: datetime, terminal: bool) -> dict[str, Any]:
+    runtime: dict[str, Any] = {}
+    seen: set[int] = set()
+    for event in sorted(events, key=lambda item: int(item.get("seq", 0))):
+        seq = int(event.get("seq", 0))
+        if seq and seq in seen:
+            continue
+        seen.add(seq)
+        runtime["event_seq"] = max(seq, int(runtime.get("event_seq", 0)))
+        projection = (event.get("extra") or {}).get("runtime_projection")
+        if isinstance(projection, dict) and projection.get("run_id") == event.get("run_id"):
+            runtime.update(projection)
+        else:
+            runtime = project_event(runtime, event)
+    if terminal:
+        runtime["activity"] = "finished"
+    elif runtime.get("activity") != "idle" and runtime.get("stage_started_at"):
+        try:
+            start = datetime.fromisoformat(runtime["stage_started_at"])
+            runtime["stage_elapsed_seconds"] = max(0, (now - start).total_seconds())
+        except (ValueError, TypeError):
+            pass
+    return runtime
