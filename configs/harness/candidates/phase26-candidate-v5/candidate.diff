+    source.write_text("absent = 1")
+    assert not registry.execute("search_code", args).data["cache"]["hit"]
+    (tmp_path / ".ignore").write_text("src/module/a.py")
+    assert not registry.execute("search_code", args).data["cache"]["hit"]
