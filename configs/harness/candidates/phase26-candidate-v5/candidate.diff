+def evidence(root, payload):
+    ref = "tool-results/" + snapshot_hash(payload) + ".json"
+    path = root / ref
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(payload), encoding="utf-8")
