diff --git a/src/codepilot/agents/exploration.py b/src/codepilot/agents/exploration.py
new file mode 100644
--- /dev/null
+++ b/src/codepilot/agents/exploration.py
@@ -0,0 +1,78 @@
+"""Deterministic, advisory exploration signals; never a forced write/stop rule."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+from dataclasses import dataclass, field
+from typing import Any
+
+
+def exploration_feedback(facts: dict[str, Any]) -> str:
+    feedback = (
+        "This query was already made. Reuse its evidence unless content changed."
+        if facts.get("repeated_query")
+        else ""
+    )
+    if facts.get("low_yield_streak", 0) >= 3 and not facts.get("has_modification"):
+        feedback += (
+            " Limited new evidence for planned files (heuristic, not proof of irrelevance). "
+            "State Hypothesis: <cause>, connect it to the public contract, and choose a minimal "
+            "source edit when supported. If evidence is insufficient, state the missing fact "
+            "and investigate a different scope. Necessary investigation remains allowed."
+        )
+    return feedback.strip()
+
+
+@dataclass
+class ExplorationProgress:
+    relevant_files: set[str] = field(default_factory=set)
+    requests: set[str] = field(default_factory=set)
+    evidence: set[str] = field(default_factory=set)
+    hypothesis: str = ""
+    modified: bool = False
+    low_yield: int = 0
+
+    def observe(
+        self, name: str, arguments: dict[str, Any], result: dict[str, Any], narration: str
+    ) -> dict[str, Any]:
+        request = json.dumps([name, arguments], sort_keys=True, ensure_ascii=False)
+        repeated = request in self.requests
+        self.requests.add(request)
+        data = result.get("data") or {}
+        new = set()
+        if result.get("ok"):
+            if name == "read_file" and data.get("path") in self.relevant_files:
+                new.add(json.dumps([data.get("path"), data.get("content")], sort_keys=True))
+            for match in data.get("matches", []):
+                if match.get("path") in self.relevant_files:
+                    new.add(json.dumps(match, sort_keys=True))
+        new = {hashlib.sha256(item.encode()).hexdigest() for item in new} - self.evidence
+        self.evidence.update(new)
+        stated = re.search(r"(?:hypothesis|根因|假设)\s*[:：]\s*([^\n]{1,500})", narration, re.I)
+        hypothesis = stated.group(1).strip() if stated else self.hypothesis
+        changed = hypothesis != self.hypothesis
+        self.hypothesis = hypothesis
+        if name in {"edit_file", "create_file"} and result.get("ok"):
+            self.modified = True
+        readonly = name in {
+            "read_file",
+            "search_code",
+            "find_symbol",
+            "get_callers",
+            "get_callees",
+            "get_related_tests",
+            "get_git_diff",
+        }
+        self.low_yield = self.low_yield + 1 if readonly and not new and not changed else 0
+        facts = {
+            "repeated_query": repeated,
+            "new_relevant_evidence": len(new),
+            "relevance_basis": "planned_file_overlap",
+            "hypothesis_changed": changed,
+            "hypothesis": hypothesis,
+            "has_modification": self.modified,
+            "low_yield_streak": self.low_yield,
+        }
+        return {**facts, "feedback": exploration_feedback(facts)}

diff --git a/src/codepilot/tools/query_cache.py b/src/codepilot/tools/query_cache.py
new file mode 100644
--- /dev/null
+++ b/src/codepilot/tools/query_cache.py
@@ -0,0 +1,187 @@
+"""Task-local bounded cache for deterministic file reads and complete searches.
+
+Content is rechecked, including negative searches and new files. Large workspaces
+bypass search caching; the original search engine/fallback always remains usable.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import shutil
+import time
+from collections import OrderedDict
+from pathlib import Path
+from typing import Any
+
+from codepilot.tools.base import Tool, ToolResponse, WorkspacePathPolicy
+
+QUERY_VERSION = "content-query-v1"
+
+
+class QueryCache:
+    def __init__(self, policy: WorkspacePathPolicy) -> None:
+        self.policy = policy
+        self.entries: OrderedDict[str, ToolResponse] = OrderedDict()
+        self.hits = 0
+        self.misses = 0
+        self.epoch = 0
+        self.last_invalidation = "first_use"
+        self.identities: OrderedDict[str, str | None] = OrderedDict()
+        source = Path(__file__).parent
+        self.version = hashlib.sha256(
+            b"".join(
+                (source / name).read_bytes()
+                for name in ("query_cache.py", "read_tools.py", "base.py")
+            )
+        ).hexdigest()
+
+    def invalidate(self, reason: str = "workspace_side_effect") -> None:
+        self.entries.clear()
+        self.epoch += 1
+        self.last_invalidation = reason
+
+    def _content_identity(self, tool: Tool, args: dict[str, Any]) -> str | None:
+        policy = self.policy
+        digest = hashlib.sha256()
+        if tool.name == "read_file":
+            path = policy.resolve(str(args["path"]), must_exist=True)
+            policy.verify_identity(path)
+            if path.stat().st_size > 8 * 1024 * 1024:
+                return None
+            digest.update(path.read_bytes())
+            return digest.hexdigest()
+        from codepilot.tools.read_tools import _iter_search_files
+
+        git_dir = policy.root / ".git"
+        if git_dir.is_file() or git_dir.is_symlink():
+            return None  # worktree/external Git ignore configuration is not task-local
+        exclude = git_dir / "info" / "exclude"
+        if exclude.exists():
+            if exclude.is_symlink() or not exclude.resolve().is_relative_to(policy.root):
+                return None
+            digest.update(exclude.read_bytes())
+        # Include ignored/hidden files too: rg ignore/config changes must invalidate
+        # cached negatives. Do not approximate rg glob semantics with pathlib.
+        started = time.monotonic()
+        total = 0
+        for count, (relative, path) in enumerate(_iter_search_files(policy, None), 1):
+            if count > 20_000 or time.monotonic() - started > 0.25:
+                return None
+            if path.is_symlink():
+                return None  # conservative bypass for a changing symlink target
+            try:
+                policy.resolve(relative, must_exist=True)
+            except ValueError:
+                continue
+            total += path.stat().st_size
+            if total > 16 * 1024 * 1024:
+                return None
+            content = path.read_bytes()
+            digest.update(json.dumps([relative, len(content)]).encode())
+            digest.update(content)
+        return digest.hexdigest()
+
+    def execute(self, tool: Tool, arguments: dict[str, Any], role: str) -> ToolResponse:
+        args = tool.input_model.model_validate(arguments).model_dump(mode="json")
+        engine: Any = None
+        if tool.name == "search_code":
+            executable = shutil.which("rg")
+            if executable:
+                stat = Path(executable).stat()
+                engine = [executable, stat.st_size, stat.st_mtime_ns]
+            else:
+                engine = "python_fallback"
+        permissions = {
+            "root": str(self.policy.root),
+            "role": role,
+            "deny_directories": sorted(self.policy.deny_directories),
+            "deny_files": sorted(self.policy.deny_files),
+        }
+        try:
+            identity = self._content_identity(tool, args)
+        except (OSError, ValueError):
+            identity = None
+        request_key = hashlib.sha256(
+            json.dumps(
+                [
+                    QUERY_VERSION,
+                    self.version,
+                    tool.name,
+                    tool.spec().parameters,
+                    args,
+                    permissions,
+                    engine,
+                ],
+                sort_keys=True,
+            ).encode()
+        ).hexdigest()
+        prior_identity = self.identities.get(request_key)
+        reason = (
+            "workspace_content_changed"
+            if request_key in self.identities and prior_identity != identity
+            else self.last_invalidation
+        )
+        self.identities[request_key] = identity
+        if len(self.identities) > 64:
+            self.identities.popitem(last=False)
+        key = hashlib.sha256(
+            json.dumps(
+                [
+                    QUERY_VERSION,
+                    self.version,
+                    engine,
+                    tool.name,
+                    tool.spec().parameters,
+                    args,
+                    permissions,
+                    identity,
+                    self.epoch,
+                ],
+                sort_keys=True,
+                ensure_ascii=False,
+            ).encode()
+        ).hexdigest()
+        if identity is not None and key in self.entries:
+            self.hits += 1
+            response = self.entries[key].model_copy(deep=True)
+            response.data["cache"] = {
+                **response.data.get("cache", {}),
+                "hit": True,
+                "identity": key,
+                "reason": "same_content_arguments_permissions_version",
+            }
+            self.entries.move_to_end(key)
+            return response
+        self.misses += 1
+        response = tool.execute(arguments)
+        kind = "error"
+        if response.ok:
+            kind = (
+                "truncated"
+                if response.data.get("truncated")
+                or any(m.get("text_truncated") for m in response.data.get("matches", []))
+                else "empty"
+                if (response.data.get("matches") == [] or response.data.get("content") == "")
+                else "complete"
+            )
+        elif response.error and response.error.code in {"not_found", "path_not_found"}:
+            kind = "missing"
+        reason = reason if identity else "identity_unavailable_or_scope_limit"
+        response.data["cache"] = {
+            "hit": False,
+            "identity": key,
+            "reason": reason,
+            "result_kind": kind,
+        }
+        # Timeout/truncation is not a complete negative. Failures are never sticky.
+        if identity is not None and response.ok and kind != "truncated":
+            try:
+                stable = self._content_identity(tool, args) == identity
+            except (OSError, ValueError):
+                stable = False
+            if stable:
+                self.entries[key] = response.model_copy(deep=True)
+                if len(self.entries) > 64:
+                    self.entries.popitem(last=False)
+        return response

