+++ b/src/codepilot/graph/evidence.py
@@ -0,0 +1,159 @@
+"""Bounded evidence projections. These do not change acceptance or test accounting."""
+
+from __future__ import annotations
+
+from typing import Any
+
+from codepilot.graph.stop_rules import patch_hash
+from codepilot.sandbox.runners import requested_filter
+from codepilot.schemas.state import RepairState
+
+
+def task_experience(state: RepairState) -> dict[str, Any]:
+    """L0 references the authoritative task state rather than copying a memory DB."""
+    return {
+        "id": f"L0:{state.run_id}",
+        "level": "L0",
+        "source_run": state.run_id,
+        "source": ["RepairState.plan", "RepairState.failure_summary", "RepairState.tool_calls"],
+        "applies_when": {"run_id": state.run_id, "candidate_hash": state.frozen_patch_hash},
+        "invalid_when": "task, candidate or public requirement changes; rederive from RepairState",
+        "version": state.policy_snapshot.get("version", "legacy"),
+        "status": "pending",
+        "action": "Use public contract and actual failure evidence; revise the hypothesis before repeating a failed patch.",
+        "evaluation_exposure": "public_only",
+    }
+
+
+def failure_summary(state: RepairState) -> dict[str, Any]:
+    attempt = state.current_attempt
+    if attempt is None or attempt.patch_hash != patch_hash(state.current_patch):
+        return {}
+    regression = attempt.regression
+    execution = attempt.execution
+    stage = "regression" if regression is not None else "target_tests"
+    if regression and regression.executions:
+        executions = list(regression.executions.values())
+        execution = next((e for e in executions if e.status.value != "PASS"), executions[-1])
+    if execution is None:
+        if attempt.validation.passed:
+            return {}
+        return {
+            "stage": "patch_validation",
+            "category": "product",
+            "expected": "A legal nonempty candidate satisfying patch rules",
+            "actual": attempt.validation.errors,
+            "candidate_hash": attempt.patch_hash,
+            "evidence_refs": [f"attempts/{attempt.iteration}/validation.json"],
+            "baseline_relation": "unknown",
+            "scope": {"observed": 0, "missing": None},
+            "new_since_last_attempt": {
+                "validation_changed": state.failure_summary.get("actual")
+                != attempt.validation.errors
+            },
+        }
+    executions = list(regression.executions.values()) if regression else [execution]
+    observed = sorted({t.node_id for e in executions for t in e.tests})
+    missing = (
+        list(regression.unexecuted_tests)
+        if regression
+        else list(
+            execution.diagnostics.get(
+                "requested_missing",
+                requested_filter(execution.tests, tuple(attempt.target_tests))[1],
+            )
+        )
+    )
+    requested = (
+        sorted(set(regression.executed_tests) | set(missing))
+        if regression
+        else list(attempt.target_tests)
+    )
+    failures = sorted({t.node_id for e in executions for t in e.failed_tests})
+    previous = state.failure_summary
+    baseline = state.baseline
+    new_failures = (
+        list(regression.new_failures)
+        if regression
+        else [
+            t
+            for t in failures
+            if baseline and str(baseline.outcomes.get(t)) == "passed" and t not in baseline.flaky
+        ]
+    )
+    categories = {"TIMEOUT": "timeout", "ENV_ERROR": "environment", "SANDBOX_ERROR": "tool"}
+    discriminator = state.plan.contract.discriminator if state.plan else None
+    return {
+        "stage": stage,
+        "category": categories.get(
+            execution.status.value, "product" if failures else "measurement"
+        ),
+        "expected": discriminator.text
+        if discriminator and discriminator.confidence != "unknown"
+        else "Public behavior expectation is unknown; selected validation scope must still complete.",
+        "actual": execution.error_reason or execution.status.value,
+        "candidate_hash": attempt.patch_hash if attempt else patch_hash(state.current_patch),
+        "evidence_refs": [e.artifact_dir for e in regression.executions.values()]
+        if regression
+        else [execution.artifact_dir],
+        "baseline_relation": "new_failures" if new_failures else "unchanged_or_unknown",
+        "scope": {
+            "requested": len(requested) if requested else None,
+            "observed": len(observed),
+            "missing": len(missing),
+            "missing_refs": missing[:20],
+            "selector_unit": "selectors; observed counts are test cases",
+        },
+        "failure_ids": failures[:20],
+        "failure_messages": [
+            {"node_id": t.node_id, "message": (t.message or "")[:1000]}
+            for e in executions
+            for t in e.failed_tests
+        ][:3],
+        "new_since_last_attempt": {
+            "new_missing_ids": sorted(
+                set(missing) - set(previous.get("scope", {}).get("missing_refs", []))
+            )[:20],
+            "new_failure_ids": sorted(set(failures) - set(previous.get("failure_ids", [])))[:20],
+            "category_changed": previous.get("actual")
+            != (execution.error_reason or execution.status.value),
+            "candidate_changed": previous.get("candidate_hash")
+            != (attempt.patch_hash if attempt else patch_hash(state.current_patch)),
+        },
+    }
+
+
+def verification_view(state: RepairState) -> dict[str, Any]:
+    """Keep execution, behavior, regression, review and coverage independent."""
+    attempt = state.current_attempt
+    candidate_bound = bool(attempt and attempt.patch_hash == patch_hash(state.current_patch))
+    regression = attempt.regression if attempt and candidate_bound else None
+    execution = attempt.execution if attempt and candidate_bound else None
+    review = state.review
+    bound = bool(review and review.reviewed_patch_hash == patch_hash(state.current_patch))
+    return {
+        "execution": execution.status.value if execution else "NOT_EXECUTED",
+        "behavior": "unknown",  # Passing self-tests alone cannot prove the public contract.
+        "regression": "not_measured"
+        if regression is None
+        else (
+            "incomplete"
+            if not regression.complete
+            else "new_failures"
+            if regression.new_failures
+            else "clean"
+        ),
+        "review": "not_executed"
+        if review is None
+        else "stale"
+        if not bound
+        else "agree"
+        if review.approved
+        else "disagree",
+        "coverage": {
+            "observed": len(regression.executed_tests) if regression else 0,
+            "missing": len(regression.unexecuted_tests) if regression else None,
+            "mode": regression.mode.value if regression else None,
+        },
+        "official": "NOT_EVALUATED",  # Official verdicts remain external, bound records.
+    }

diff --git a/src/codepilot/graph/harness.py b/src/codepilot/graph/harness.py
new file mode 100644
--- /dev/null
+++ b/src/codepilot/graph/harness.py
@@ -0,0 +1,183 @@
+"""Small lifecycle integration for the existing graph and checkpoint state."""
+
+from __future__ import annotations
+
+import json
+from typing import Any
+
+from codepilot.graph.deps import Deps
+from codepilot.graph.evidence import failure_summary, verification_view
+from codepilot.observability.lifecycle import snapshot_hash
+from codepilot.rsi import archive_root, load_selection, read_json, retrieve, snapshot_sources
+from codepilot.schemas.state import RepairState
+
+
+def begin(state: RepairState, deps: Deps, stage: str) -> RepairState:
+    policy = state.policy_snapshot
+    if not deps.harness_started:
+        if policy:
+            snapshot = read_json(deps.artifacts.run_dir / "harness/snapshot.json")
+            if snapshot_hash(snapshot) != policy.get("sha256"):
+                raise ValueError(
+                    "fixed policy snapshot identity mismatch; refusing in-flight switch"
+                )
+        else:
+            try:
+                selection = load_selection()
+            except (OSError, ValueError, KeyError) as exc:
+                deps.lifecycle.emit("policy_load_failed", error=str(exc), fallback="builtin")
+                selection = {
+                    "schema_version": 1,
+                    "version": "builtin-phase26-v1",
+                    "status": "pending",
+                    "instruction": "",
+                    "experiences": [],
+                }
+            try:
+                sources = snapshot_sources()
+            except OSError as exc:
+                deps.lifecycle.emit("source_snapshot_unavailable", error=str(exc))
+                sources = {}
+            snapshot = {
+                "selection": selection,
+                "selection_source": str(archive_root()),
+                "sources": sources,
+                "plugins": deps.lifecycle.versions(),
+                "prompts": {
+                    "coder": selection.get("prompts", {}).get(
+                        "coder", getattr(deps.coder, "system_prompt", "")
+                    ),
+                    "planner": selection.get("prompts", {}).get(
+                        "planner", getattr(deps.planner, "system_prompt", "")
+                    ),
+                    "reviewer": selection.get("prompts", {}).get(
+                        "reviewer", getattr(deps.reviewer, "system_prompt", "")
+                    ),
+                },
+            }
+            deps.artifacts.write_json("harness/snapshot.json", snapshot)
+            policy = {
+                "version": selection["version"],
+                "sha256": snapshot_hash(snapshot),
+                "artifact": "harness/snapshot.json",
+                "status": selection.get("status", "pending"),
+            }
+        selection = snapshot["selection"]
+        deps.experience_snapshot = retrieve(selection, deps.repository)
+        cache = getattr(deps.tools, "query_cache", None)
+        if cache is not None:
+            counters = state.runtime.get("cache", {})
+            cache.hits = int(counters.get("hits", 0))
+            cache.misses = int(counters.get("misses", 0))
+            if state.events:
+                cache.last_invalidation = "worker_restart_no_memory_cache"
+        for name, prompt in snapshot.get("prompts", {}).items():
+            agent = getattr(deps, name, None)
+            if agent is not None and hasattr(agent, "system_prompt"):
+                agent.system_prompt = prompt
+        deps.coder.experience_feedback = json.dumps(
+            {"instruction": selection.get("instruction", ""), "entries": deps.experience_snapshot},
+            ensure_ascii=False,
+        )
+        deps.harness_started = True
+        deps.lifecycle.bind(
+            {"task_id": state.task_id, "stage": stage, "iteration": state.iteration},
+            str(policy["sha256"]),
+        )
+        deps.lifecycle.emit(
+            "resume" if state.events else "task_start",
+            snapshot=policy,
+            reuse="checkpoint-completed nodes, settled responses and identity-valid evidence"
+            if state.events
+            else "none",
+            redo="pending or invalidated stages; no exactly-once guarantee across crash windows"
+            if state.events
+            else "none",
+        )
+    now = deps.clock().isoformat()
+    deps.lifecycle.external_wait_seconds = 0.0
+    runtime = {
+        **state.runtime,
+        "stage": stage,
+        "stage_started_at": now,
+        "stage_elapsed_seconds": 0.0,
+        "activity": "executing",
+        "revision": int(state.runtime.get("revision", 0)) + 1,
+    }
+    deps.lifecycle.bind(
+        {
+            "task_id": state.task_id,
+            "stage": stage,
+            "iteration": state.iteration,
+            "revision": runtime["revision"],
+            "candidate_hash": state.frozen_patch_hash,
+        },
+        str(policy["sha256"]),
+    )
+    deps.lifecycle.emit("stage_start", started_at=now, runtime=runtime)
+    return state.model_copy(
+        update={
+            "runtime": runtime,
+            "policy_snapshot": policy,
+            "experience_refs": [f"{e['id']}@{e['version']}" for e in deps.experience_snapshot],
+        }
+    )
+
+
+def complete(
+    state: RepairState, update: dict[str, Any], deps: Deps, elapsed: float
+) -> dict[str, Any]:
+    merged = state.model_copy(update=update)
+    runtime = {
+        **state.runtime,
+        "stage_elapsed_seconds": round(elapsed, 3),
+        "activity": "idle",
+        "last_completed_at": deps.clock().isoformat(),
+    }
+    durations = dict(runtime.get("stage_seconds", {}))
+    stage = str(runtime["stage"])
+    durations[stage] = round(durations.get(stage, 0) + elapsed, 3)
+    runtime["stage_seconds"] = durations
+    runtime["external_wait_seconds"] = round(
+        float(state.runtime.get("external_wait_seconds", 0)) + deps.lifecycle.external_wait_seconds,
+        3,
+    )
+    runtime["executing_seconds"] = round(
+        float(state.runtime.get("executing_seconds", 0))
+        + max(0, elapsed - deps.lifecycle.external_wait_seconds),
+        3,
+    )
+    cache = getattr(deps.tools, "query_cache", None)
+    runtime["cache"] = {"hits": cache.hits, "misses": cache.misses} if cache else {}
+    if merged.current_patch != state.current_patch:
+        deps.lifecycle.emit(
+            "candidate_changed", old=state.frozen_patch_hash, new=merged.frozen_patch_hash
+        )
+        runtime["last_effective_progress"] = deps.clock().isoformat()
+    if stage in {"validate_patch", "run_target_tests", "run_regression"}:
+        summary = failure_summary(merged)
+        deps.artifacts.write_json(f"failures/{stage}-{state.iteration}.json", summary)
+        update["failure_summary"] = summary
+        deps.lifecycle.emit(
+            "after_validation", view=verification_view(merged), failure_summary=summary
+        )
+        if summary and summary != state.failure_summary:
+            runtime["last_effective_progress"] = deps.clock().isoformat()
+    if stage == "plan" and merged.plan:
+        contract = merged.plan.contract.model_dump(mode="json")
+        deps.artifacts.write_json("harness/contract.json", contract)
+        deps.lifecycle.emit("contract_ready", contract=contract)
+        if merged.plan != state.plan:
+            runtime["last_effective_progress"] = deps.clock().isoformat()
+    for call in update.get("tool_calls", []):
+        progress = call.get("result_summary", {}).get("exploration", {})
+        if progress.get("new_relevant_evidence") or progress.get("hypothesis_changed"):
+            runtime["last_effective_progress"] = deps.clock().isoformat()
+            runtime["progress_basis"] = "planned_file_overlap_or_stated_hypothesis; heuristic"
+    deps.lifecycle.emit("stage_end", duration_seconds=elapsed, runtime=runtime)
+    return {
+        **update,
+        "runtime": runtime,
+        "policy_snapshot": state.policy_snapshot,
+        "experience_refs": state.experience_refs,
+    }

diff --git a/src/codepilot/observability/lifecycle.py b/src/codepilot/observability/lifecycle.py
new file mode 100644
--- /dev/null
+++ b/src/codepilot/observability/lifecycle.py
@@ -0,0 +1,114 @@
+"""Ordered read-only observers. Suggestions are committed by the graph executor."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from collections.abc import Mapping
+from types import MappingProxyType
+from typing import Any, Protocol
+
+from codepilot.observability.events import EventSink, EventType
+
+
+def freeze(value: Any) -> Any:
+    if isinstance(value, dict):
+        return MappingProxyType({k: freeze(v) for k, v in value.items()})
+    if isinstance(value, list):
+        return tuple(freeze(v) for v in value)
+    return value
+
+
+class Observer(Protocol):
+    name: str
+    version: str
+
+    def observe(
+        self, hook: str, state: Mapping[str, Any], facts: Mapping[str, Any]
+    ) -> Mapping[str, Any]: ...
+
+
+class ResourceObserver:
+    """Resource classification seam for existing scheduling, not a new scheduler."""
+
+    name = "resource-classification"
+    version = "1"
+
+    def observe(
+        self, hook: str, state: Mapping[str, Any], facts: Mapping[str, Any]
+    ) -> Mapping[str, Any]:
+        if hook == "before_model":
+            return {"resource": "model", "activity": "external_wait"}
+        if hook == "before_tool":
+            permission = facts.get("permission")
+            resource = (
+                "test"
+                if permission == "execute"
+                else "workspace_write"
+                if permission == "write"
+                else "query"
+            )
+            return {"resource": resource, "activity": "executing"}
+        if hook == "stage_start":
+            stage = str(state.get("stage", ""))
+            return {
+                "resource": {
+                    "retrieve": "index_read",
+                    "build_env": "environment",
+                    "run_target_tests": "test",
+                    "run_regression": "test",
+                }.get(stage, "orchestration")
+            }
+        return {}
+
+
+class Lifecycle:
+    def __init__(self, events: EventSink, observers: tuple[Observer, ...] | None = None) -> None:
+        self.events = events
+        self.observers = observers if observers is not None else (ResourceObserver(),)
+        self.state: Mapping[str, Any] = MappingProxyType({})
+        self.policy_hash = ""
+        self.external_wait_seconds = 0.0
+
+    def bind(self, state: dict[str, Any], policy_hash: str) -> None:
+        self.state = freeze(state)
+        self.policy_hash = policy_hash
+
+    def emit(self, hook: str, **facts: Any) -> list[dict[str, Any]]:
+        if hook == "after_model":
+            self.external_wait_seconds += float(facts.get("duration_seconds", 0.0))
+        suggestions = []
+        for observer in self.observers:
+            try:
+                advice = dict(observer.observe(hook, self.state, freeze(facts)))
+                if advice:
+                    suggestions.append({"observer": observer.name, **advice})
+            except Exception as exc:
+                self.events.emit(
+                    node=str(self.state.get("stage", "lifecycle")),
+                    type=EventType.LIFECYCLE,
+                    status="observer_error",
+                    hook=hook,
+                    observer=observer.name,
+                    error=f"{type(exc).__name__}: {exc}",
+                )
+        self.events.emit(
+            node=str(self.state.get("stage", "lifecycle")),
+            type=EventType.LIFECYCLE,
+            status=hook,
+            hook=hook,
+            policy_hash=self.policy_hash,
+            summary=str(facts.get("feedback") or hook),
+            facts=facts,
+            suggestions=suggestions,
+        )
+        return suggestions
+
+    def versions(self) -> dict[str, str]:
+        return {observer.name: observer.version for observer in self.observers}
+
+
+def snapshot_hash(snapshot: dict[str, Any]) -> str:
+    return hashlib.sha256(
+        json.dumps(snapshot, sort_keys=True, ensure_ascii=False).encode()
+    ).hexdigest()

diff --git a/src/codepilot/api/runtime_view.py b/src/codepilot/api/runtime_view.py
new file mode 100644
--- /dev/null
+++ b/src/codepilot/api/runtime_view.py
@@ -0,0 +1,54 @@
+"""Read-only projections of existing lifecycle events; no second run state store."""
+
+from __future__ import annotations
+
+from datetime import datetime
+from typing import Any
+
+
+def activity_view(events: list[dict[str, Any]], *, now: datetime, terminal: bool) -> dict[str, Any]:
+    runtime: dict[str, Any] = {}
+    for event in events:
+        extra = event.get("extra") or {}
+        facts = extra.get("facts") or {}
+        hook = extra.get("hook")
+        for suggestion in extra.get("suggestions", []):
+            if suggestion.get("resource"):
+                runtime["resource"] = suggestion["resource"]
+        if hook in {"stage_start", "stage_end"}:
+            runtime.update(facts.get("runtime") or {})
+        if hook == "before_model":
+            runtime["activity"] = "external_wait"
+        if event.get("type") == "llm_call" or hook in {
+            "after_model",
+            "before_tool",
+            "after_tool",
+            "exploration",
+        }:
+            runtime["activity"] = "executing"
+        if hook == "exploration" and (
+            facts.get("new_relevant_evidence")
+            or facts.get("hypothesis_changed")
+            or facts.get("has_modification")
+        ):
+            runtime["last_effective_progress"] = event.get("timestamp")
+        if hook == "resume":
+            runtime["recovery"] = {"reuse": facts.get("reuse"), "redo": facts.get("redo")}
+        if hook == "contract_ready":
+            runtime["contract"] = facts.get("contract")
+        if hook == "after_validation":
+            runtime["verification"] = facts.get("view")
+            runtime["failure_summary"] = facts.get("failure_summary")
+        if hook == "after_tool" and facts.get("cache"):
+            runtime["last_cache"] = facts["cache"]
+        if hook == "stage_end":
+            runtime["activity"] = "idle"
+    if terminal:
+        runtime["activity"] = "finished"
+    elif runtime.get("activity") != "idle" and runtime.get("stage_started_at"):
+        try:
+            start = datetime.fromisoformat(runtime["stage_started_at"])
+            runtime["stage_elapsed_seconds"] = max(0, (now - start).total_seconds())
+        except (ValueError, TypeError):
+            pass
+    return runtime

diff --git a/src/codepilot/rsi.py b/src/codepilot/rsi.py
new file mode 100644
--- /dev/null
+++ b/src/codepilot/rsi.py
@@ -0,0 +1,284 @@
+"""Offline, append-only improvement archives. No model, sandbox or network imports.
+
+Only explicit selection changes future task advice. Historical results and costs
+are never inputs to a write operation. Python code still uses worker/checkpoints.
+"""
+
+from __future__ import annotations
+
+import argparse
+import ast
+import hashlib
+import json
+import os
+import re
+from pathlib import Path
+from typing import Any
+
+ROOT = Path(__file__).resolve().parents[2]
+DEFAULT_ARCHIVE = ROOT / "configs" / "harness"
+SOURCE_FILES = (
+    "agents/coder.py",
+    "agents/planner.py",
+    "agents/reviewer.py",
+    "agents/exploration.py",
+    "tools/query_cache.py",
+    "observability/lifecycle.py",
+    "graph/evidence.py",
+    "graph/harness.py",
+    "tools/registry.py",
+    "rsi.py",
+)
+
+
+def read_json(path: Path) -> dict[str, Any]:
+    payload = json.loads(path.read_text(encoding="utf-8"))
+    if not isinstance(payload, dict):
+        raise ValueError(f"expected JSON object: {path}")
+    return payload
+
+
+def version_dir(root: Path, version: str) -> Path:
+    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,99}", version) or ".." in version:
+        raise ValueError("invalid version identifier")
+    path = root.resolve() / "candidates" / version
+    if not path.resolve().is_relative_to(root.resolve()):
+        raise ValueError("archive path escapes root")
+    return path
+
+
+def snapshot_sources() -> dict[str, str]:
+    base = Path(__file__).resolve().parent
+    return {name: (base / name).read_text(encoding="utf-8") for name in SOURCE_FILES}
+
+
+def extract_prompts(sources: dict[str, str]) -> dict[str, str]:
+    prompts = {}
+    for role in ("coder", "planner", "reviewer"):
+        for node in ast.walk(ast.parse(sources[f"agents/{role}.py"])):
+            if not isinstance(node, ast.Assign):
+                continue
+            if any(
+                (isinstance(t, ast.Name) and t.id == "_SYSTEM")
+                or (isinstance(t, ast.Attribute) and t.attr == "system_prompt")
+                for t in node.targets
+            ):
+                try:
+                    value = ast.literal_eval(node.value)
+                except ValueError:
+                    continue
+                if isinstance(value, str):
+                    prompts[role] = value
+                    break
+    return prompts
+
+
+def validate_snapshot(snapshot: dict[str, Any]) -> dict[str, Any]:
+    if snapshot.get("schema_version") != 1:
+        raise ValueError("unsupported policy snapshot")
+    if not isinstance(snapshot.get("instruction", ""), str):
+        raise ValueError("instruction must be text")
+    prompts = snapshot.get("prompts", {})
+    if not isinstance(prompts, dict) or any(
+        k not in {"coder", "planner", "reviewer"} or not isinstance(v, str)
+        for k, v in prompts.items()
+    ):
+        raise ValueError("prompts must be versioned role text, not executable objects")
+    entries = snapshot.get("experiences", [])
+    if not isinstance(entries, list) or len(entries) > 100:
+        raise ValueError("experiences must be a bounded list")
+    required = {
+        "id",
+        "level",
+        "source",
+        "source_run",
+        "applies_when",
+        "invalid_when",
+        "action",
+        "version",
+        "status",
+        "evaluation_exposure",
+    }
+    for entry in entries:
+        if not isinstance(entry, dict) or not required <= entry.keys():
+            raise ValueError("experience provenance is incomplete")
+        if entry["level"] not in {"L1", "L2", "L3"}:
+            raise ValueError("L0 is task state; archived entries must be L1/L2/L3")
+        if entry["evaluation_exposure"] != "public_only":
+            raise ValueError("hidden-test/reference-patch experience is not injectable")
+        if entry["level"] == "L3" and not entry.get("comparison_refs"):
+            raise ValueError("L3 requires version comparison evidence")
+        if entry["status"] not in {"pending", "validated", "retired"}:
+            raise ValueError("invalid experience status")
+    return snapshot
+
+
+def archive_root() -> Path:
+    return Path(os.environ.get("CODEPILOT_HARNESS_ARCHIVE", str(DEFAULT_ARCHIVE))).resolve()
+
+
+def load_selection(root: Path | None = None) -> dict[str, Any]:
+    root = root if root is not None else archive_root()
+    pointer = root / "active.json"
+    if not pointer.exists():
+        return {
+            "schema_version": 1,
+            "version": "builtin-phase26-v1",
+            "parent": None,
+            "status": "pending",
+            "instruction": "",
+            "experiences": [],
+        }
+    version = read_json(pointer)["version"]
+    return validate_snapshot(read_json(version_dir(root, str(version)) / "snapshot.json"))
+
+
+def retrieve(snapshot: dict[str, Any], repository: str) -> list[dict[str, Any]]:
+    """Small exact-scope retrieval, frozen per task. No vector DB or hidden input."""
+    return [
+        entry
+        for entry in snapshot.get("experiences", [])
+        if entry["status"] != "retired" and entry.get("repository", "*") in {"*", repository}
+    ][:4]
+
+
+def archive_candidate(root: Path, version: str, proposal: dict[str, Any]) -> Path:
+    if not all(
+        proposal.get(k)
+        for k in ("hypothesis", "input_evidence", "candidate_changes", "code_revision")
+    ):
+        raise ValueError(
+            "hypothesis, public evidence, candidate changes and code revision are required"
+        )
+    parent = proposal.get("parent")
+    if parent:
+        read_json(version_dir(root, str(parent)) / "snapshot.json")
+    sources = snapshot_sources()
+    snapshot = validate_snapshot(
+        {
+            "schema_version": 1,
+            "version": version,
+            "parent": parent,
+            "status": "pending",
+            "instruction": proposal.get("instruction", ""),
+            "prompts": proposal.get("prompts", extract_prompts(sources)),
+            "experiences": [{**e, "status": "pending"} for e in proposal.get("experiences", [])],
+        }
+    )
+    folder = version_dir(root, version)
+    folder.mkdir(parents=True, exist_ok=False)
+    payload = {
+        **proposal,
+        "schema_version": 1,
+        "version": version,
+        "parent": parent,
+        "status": "pending",
+        "snapshot": snapshot,
+        "source_hashes": {p: hashlib.sha256(t.encode()).hexdigest() for p, t in sources.items()},
+        "source_snapshot": sources,
+        "static_results": proposal.get("static_results", ["not checked"]),
+        "future_metrics": proposal.get(
+            "future_metrics", ["quality", "regressions", "time", "cost"]
+        ),
+        "effect_validation": "NOT_RUN",
+        "auto_promote": False,
+    }
+    for name, content in (("snapshot.json", snapshot), ("candidate.json", payload)):
+        (folder / name).write_text(
+            json.dumps(content, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
+        )
+    return folder
+
+
+def select(root: Path, version: str, *, allow_pending: bool = False) -> None:
+    snapshot = validate_snapshot(read_json(version_dir(root, version) / "snapshot.json"))
+    if snapshot.get("status") != "validated" and not allow_pending:
+        raise ValueError(
+            "pending candidate: explicit --allow-pending required; effects remain unverified"
+        )
+    root.mkdir(parents=True, exist_ok=True)
+    target = root / "active.json"
+    temporary = root / "active.next.json"
+    temporary.write_text(
+        json.dumps({"version": version, "new_tasks_only": True}) + "\n", encoding="utf-8"
+    )
+    temporary.replace(target)
+
+
+def replay(path: Path, *, decisions: bool = False) -> list[dict[str, Any]]:
+    from codepilot.agents.exploration import exploration_feedback
+
+    records = []
+    with path.open(encoding="utf-8") as handle:
+        for line_no, line in enumerate(handle, 1):
+            if not line.strip():
+                continue
+            try:
+                event = json.loads(line)
+                if not isinstance(event, dict):
+                    raise ValueError("event is not an object")
+            except (ValueError, TypeError) as exc:
+                records.append({"line": line_no, "error": str(exc)})
+                continue
+            if decisions:
+                extra = event.get("extra")
+                if not isinstance(extra, dict) or extra.get("hook") != "exploration":
+                    continue
+                facts = extra.get("facts")
+                if not isinstance(facts, dict):
+                    records.append({"line": line_no, "error": "exploration facts unavailable"})
+                    continue
+                records.append(
+                    {
+                        "line": line_no,
+                        "mode": "deterministic_decision",
+                        "old_feedback": facts.get("feedback"),
+                        "feedback": exploration_feedback(facts),
+                        "effect_validation": "NOT_RUN",
+                    }
+                )
+            else:
+                records.append({"line": line_no, "mode": "trace", "event": event})
+    return records
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--root", type=Path, default=DEFAULT_ARCHIVE)
+    sub = parser.add_subparsers(dest="command", required=True)
+    sub.add_parser("list")
+    for command in ("show", "select", "rollback"):
+        item = sub.add_parser(command)
+        item.add_argument("version")
+        if command != "show":
+            item.add_argument("--allow-pending", action="store_true")
+    create = sub.add_parser("archive")
+    create.add_argument("version")
+    create.add_argument("--proposal", type=Path, required=True)
+    trace = sub.add_parser("replay")
+    trace.add_argument("path", type=Path)
+    trace.add_argument("--mode", choices=("trace", "decision"), default="trace")
+    args = parser.parse_args()
+    if args.command == "list":
+        result: Any = [
+            p.parent.name for p in sorted((args.root / "candidates").glob("*/snapshot.json"))
+        ]
+    elif args.command == "replay":
+        result = replay(args.path, decisions=args.mode == "decision")
+    elif args.command == "archive":
+        result = str(archive_candidate(args.root, args.version, read_json(args.proposal)))
+    elif args.command == "show":
+        result = read_json(version_dir(args.root, args.version) / "candidate.json")
+    else:
+        version = args.version
+        if args.command == "rollback":
+            version = read_json(version_dir(args.root, version) / "snapshot.json").get("parent")
+            if not version:
+                raise ValueError("candidate has no archived parent")
+        select(args.root, version, allow_pending=args.allow_pending)
+        result = {"selected_for_new_tasks": version, "historical_results_unchanged": True}
+    print(json.dumps(result, ensure_ascii=False, indent=2))
+
+
+if __name__ == "__main__":
+    main()

