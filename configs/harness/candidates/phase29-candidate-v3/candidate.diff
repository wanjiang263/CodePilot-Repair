+import argparse
+import ast
+import hashlib
+import json
+import os
+import re
+from pathlib import Path
+from typing import Any
+
+ROOT = Path(__file__).resolve().parents[2]
+DEFAULT_ARCHIVE = ROOT / "configs" / "harness"
+SOURCE_FILES = (
+    "agents/coder.py",
+    "agents/planner.py",
+    "agents/reviewer.py",
+    "agents/exploration.py",
+    "tools/query_cache.py",
+    "tools/read_tools.py",
+    "observability/resources.py",
+    "observability/dispatch.py",
+    "graph/validation_time.py",
+    "tools/base.py",
+    "llm/retry.py",
+    "llm/dispatch_budget.py",
+    "llm/openai_compatible.py",
+    "llm/anthropic_messages.py",
+    "storage/models.py",
+    "storage/repository.py",
+    "observability/runtime.py",
+    "graph/deps.py",
+    "graph/nodes.py",
+    "graph/builder.py",
+    "graph/checkpoint.py",
+    "repo/index.py",
+    "eval/assembly.py",
+    "llm/tracking.py",
+    "observability/lifecycle.py",
+    "graph/evidence.py",
+    "graph/harness.py",
+    "tools/registry.py",
+    "rsi.py",
+)
