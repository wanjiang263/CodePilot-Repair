+        run_id="run",
+        repository_id="repo",
+        base_commit="abc",
+        issue="public issue",
+        started_at=datetime.now(UTC),
+    )
+    first = harness.begin(initial, deps(), "plan")
+    monkeypatch.setattr(
+        harness,
+        "load_selection",
+        lambda: (_ for _ in ()).throw(AssertionError("must use saved snapshot")),
+    )
+    resumed_deps = deps()
