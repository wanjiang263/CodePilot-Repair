+def registry(root: Path) -> ToolRegistry:
+    policy = WorkspacePathPolicy(root)
+    result = ToolRegistry(
+        [
+            read_file_tool(policy),
+            search_code_tool(policy),
+            edit_file_tool(policy),
+            create_file_tool(policy),
+        ]
+    )
+    result.query_cache = QueryCache(policy)
+    return result
