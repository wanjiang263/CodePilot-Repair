+        )
+        if verified["association_mode"] != "verified_snapshot_v2":
+            raise RuntimeError(f"verified reuse 未命中: {verified['association_mode']}")
+        (WORKSPACE_DIR / HUB_RELPATH).write_text(hub_variant(i), encoding="utf-8", newline="\n")
+        run = execute_index(
